# Copy this file to .env and replace with your own secure values.
# NEVER commit the .env file to version control.

# HMAC-SHA256 audit trail signing key (minimum 16 characters).
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=replace-with-a-strong-random-key

# LLM provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock
